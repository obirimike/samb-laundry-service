generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum ServiceCategory {
  CLEANING
  LAUNDRY
  DOMESTIC_SUPPORT
  PEST_CONTROL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?
  role         UserRole @default(CUSTOMER)

  bookings              Booking[]
  notifications         Notification[]
  quotesCreated         Quote[]             @relation("QuotesCreated")
  assignmentsReceived   BookingAssignment[] @relation("AssignmentStaff")
  assignmentsCreated    BookingAssignment[] @relation("AssignmentCreatedBy")
  assignmentsUnassigned BookingAssignment[] @relation("AssignmentUnassignedBy")
  reviews               Review[]            @relation("CustomerReviews")
  reviewsModerated      Review[]            @relation("ReviewsModerated")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Service {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String
  category    ServiceCategory
  imageUrl    String?
  isActive    Boolean         @default(true)

  bookings Booking[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model Booking {
  id            String @id @default(uuid())
  bookingNumber String @unique

  customerId String
  serviceId  String

  status BookingStatus @default(PENDING)

  preferredDate DateTime
  preferredTime String

  address             String
  propertyType        String?
  numberOfRooms       Int?
  estimatedSize       String?
  specialInstructions String?

  adminNotes String?

  customer    User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service     Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  quotes      Quote[]
  assignments BookingAssignment[]
  review      Review?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@index([preferredDate])
}

model Notification {
  id String @id @default(uuid())

  userId  String
  title   String
  message String
  type    String
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model ContactMessage {
  id String @id @default(uuid())

  name    String
  email   String
  phone   String?
  subject String
  message String
  status  ContactMessageStatus @default(NEW)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Quote {
  id          String @id @default(uuid())
  quoteNumber String @unique

  bookingId   String
  createdById String

  amount    Decimal @db.Decimal(12, 2)
  currency  String  @default("GHS")
  breakdown Json?
  terms     String? @db.Text

  status       QuoteStatus @default(DRAFT)
  expiresAt    DateTime?
  sentAt       DateTime?
  respondedAt  DateTime?
  responseNote String?     @db.Text

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy User    @relation("QuotesCreated", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revision        Int     @default(1)
  previousQuoteId String?

  previousQuote Quote?  @relation("QuoteRevisions", fields: [previousQuoteId], references: [id], onDelete: SetNull)
  revisions     Quote[] @relation("QuoteRevisions")

  @@unique([previousQuoteId])
  @@index([bookingId, createdAt])
  @@index([createdById])
  @@index([status, expiresAt])
  @@index([bookingId, revision])
}

model BookingAssignment {
  id             String  @id @default(uuid())
  bookingId      String
  staffId        String
  assignedById   String
  unassignedById String?

  notes    String? @db.Text
  isActive Boolean @default(true)

  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff        User    @relation("AssignmentStaff", fields: [staffId], references: [id], onDelete: Restrict)
  assignedBy   User    @relation("AssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  unassignedBy User?   @relation("AssignmentUnassignedBy", fields: [unassignedById], references: [id], onDelete: SetNull)

  @@index([bookingId, isActive])
  @@index([staffId, isActive])
  @@index([assignedById])
  @@index([unassignedById])
}

model Review {
  id         String @id @default(uuid())
  bookingId  String @unique
  customerId String
  serviceId  String

  rating  Int
  comment String?      @db.Text
  status  ReviewStatus @default(PENDING)

  moderationNote String?   @db.Text
  moderatedById  String?
  moderatedAt    DateTime?

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer    User    @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Restrict)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  moderatedBy User?   @relation("ReviewsModerated", fields: [moderatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}
